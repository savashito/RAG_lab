# apps/rewrite_lab/.env — configuración del app en producción.
# Copia a `.env` (NO se commitea) y llena los valores.

# ── Autenticación Google (obligatorio en prod) ──────────────────────────────
# Credenciales del "OAuth 2.0 Client ID" (tipo Web) creado en Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Llave para firmar la cookie de sesión. Genera una con:  python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=pon_aqui_un_secreto_largo_y_aleatorio
# La lista blanca vive en la tabla `rewrite_lab_users` (DB) y se gestiona desde el tab
# "Usuarios" (solo superadmin). ALLOWED_EMAILS solo SIEMBRA esa tabla la 1a vez (como
# lectores); después manda la DB. Separados por coma.
ALLOWED_EMAILS=rodrigosavagerower@gmail.com
# Superadmin: puede gestionar usuarios y subir a todo. Se re-siembra al arrancar aunque
# borren su fila. Por defecto rodrigosavagerower@gmail.com si no se define.
SUPERADMIN_EMAIL=rodrigosavagerower@gmail.com
# URL absoluta del callback (debe coincidir EXACTO con la "Authorized redirect URI" en Google).
OAUTH_REDIRECT_URL=https://legis.tlacua.cloud/auth/callback

# ── Servicios (en el server) ────────────────────────────────────────────────
# Postgres LOCAL del server (no el 5433 del túnel de la laptop).
RAG_DB_HOST=127.0.0.1
RAG_DB_PORT=5432
RAG_DB_NAME=rag
RAG_DB_USER=rag
RAG_DB_PASSWORD=xxxxxxxx
# TEI (embeddings) y LLM (llama) viven en rtx5090; en el server se alcanzan por un
# túnel local prod→rtx5090 (ver README de despliegue).
TEI_URL=http://127.0.0.1:8085
LLM_URL=http://127.0.0.1:41499
# Reranker cross-encoder (TEI, /rerank). Opcional: si está vacío, el reranking se
# desactiva y el checkbox no tiene efecto. Levántalo con ./serve_reranker.sh
RERANK_URL=http://127.0.0.1:8086

# ── App ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8060
LEGAL_TABLE=sistema_penal__qwen06__legal

# ── Tab "Ingestar documentos" (opcional; hay defaults sensatos) ──────────────
# Dónde se guardan los Markdown LIMPIOS de los PDFs ingeridos (persisten, para
# visualizarlos en la UI). Default: ingestion/out_clean/Sistema Penal Acusatorio.
# CLEAN_MD_DIR=/ruta/persistente/clean_md
# Dónde caen los PDFs subidos (temporales; se borran al terminar el job).
# Default: ingestion/.uploads
# UPLOAD_DIR=/ruta/tmp/uploads
