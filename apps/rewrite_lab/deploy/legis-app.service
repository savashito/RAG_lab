# sudo cp /home/tlacua/apps/RAG_lab/apps/rewrite_lab/deploy/legis-app.service /etc/systemd/system/
# sudo systemctl enable --now legis-app
[Unit]
Description=legis RAG app (rewrite_lab, uvicorn 8060)
After=network-online.target

[Service]
User=tlacua
WorkingDirectory=/home/tlacua/apps/RAG_lab/apps/rewrite_lab
ExecStart=/home/tlacua/apps/RAG_lab/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8060 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
