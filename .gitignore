# ── Secrets — never commit ────────────────────────────────────────────────────
.env
*.env
.env.bak*
!.env.example
.claude/settings.local.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── uv ────────────────────────────────────────────────────────────────────────
# uv.lock IS committed on purpose (reproducible installs) — do not ignore it.

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Data / artifacts (patient-level data must not land in git) ─────────────────
data/
data.zip
*.zip
*.joblib
*.png
*.pdf
# Salidas de ingesta (Markdown OCR'd / limpio); no doc del repo. (Antes: *.md genérico,
# que también ignoraba READMEs/FUTURE_WORK y demás docs.)
/ingestion/out/
/ingestion/out_clean/
/ingestion/markdown/
scratch/
# runtime work dir — staged canonical CSVs (patient PII) + geometry; never commit
var/

# ── Vendored front-end libs (fetched by scripts/vendor.sh) ─────────────────────
static/vendor/

# ── Local preview/demo artifacts (generated) ──────────────────────────────────
static/demo/

# ── Ingestion lab: user PDFs and generated Markdown (do not commit) ──
ingestion/pdfs/
ingestion/out/
ingestion/out_clean/    # Markdown LIMPIO generado por el pipeline (visualizable)
ingestion/.uploads/     # PDFs subidos por el tab del app (temporales)
