# ── Secrets — never commit ────────────────────────────────────────────────────
.env
*.env
.env.bak*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── uv ────────────────────────────────────────────────────────────────────────
# uv.lock IS committed on purpose (reproducible installs) — do not ignore it.

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Data / artifacts (patient-level data must not land in git) ─────────────────
data/
data.zip
*.zip
*.joblib
*.png
scratch/
# runtime work dir — staged canonical CSVs (patient PII) + geometry; never commit
var/

# ── Vendored front-end libs (fetched by scripts/vendor.sh) ─────────────────────
static/vendor/

# ── Local preview/demo artifacts (generated) ──────────────────────────────────
static/demo/
